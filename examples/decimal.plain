Const ERROR_NO_ERRORS_SUCCESS As Numeric = 0

Const MORE_THAN_YOU_SHOULD_EVER_NEED As Numeric = 10000

System.SetErrorHandler(MyErrorHandler)
Const Result As Numeric = Main()
System.Exit(Result)

'----------

Function Main() As Numeric
    Console.Cls()
    Console.PrintLine("PLAIN Decimal Demo")
    Console.PrintLine("------------------")
    Console.PrintLine()

    Console.PrintLine("Temperature Converter")
    Console.PrintLine("Enter a blank line to exit")

    Var celsius As Numeric = 0
    Var fahrenheit As Numeric = 0
    Var ConversionRequested As String
    For i As Numeric = 1 To MORE_THAN_YOU_SHOULD_EVER_NEED
        ConversionRequested = Console.Input("Convert to (C)elsius or (F)ahrenheit? ")
        Var ConversionKey As String = String.Upper(String.Left(String.Trim(ConversionRequested), 1))
        'Select Case String.Upper(String.Left(String.Trim(ConversionRequested), 1))
        '    Case ""
        '        i = MORE_THAN_YOU_SHOULD_EVER_NEED
        '    Case "C"
        '        celsius = Input("Enter Celsius: ")
        '        fahrenheit = Format(ConvertCelsiusToFahrenheit(String.ToNumeric(celsius)), 1)
        '        Console.PrintLine(celsius + " degrees Celsius is " + fahrenheit + " degrees Fahrenheit")
        '    Case "F"
        '        fahrenheit = Input("Enter Fahrenheit: ")
        '        celsius = Format(ConvertFahrenheitToCelsius(String.ToNumeric(fahrenheit)), 1)
        '        Console.PrintLine(fahrenheit + " degrees Celsius is " + celsius + " degrees Fahrenheit")
        '    'Case Else
        '    '    Console.PrintLine("I don't know what you want.")
        'End Select

        If ConversionKey == "" Then
            i = MORE_THAN_YOU_SHOULD_EVER_NEED
        Else
            Var tookAction As Boolean = False
            If ConversionKey == "C" Then
                celsius = Console.Input("Enter Celsius: ")
                fahrenheit = Decimal.Format(ConvertCelsiusToFahrenheit(String.ToNumeric(celsius)), 1)
                Console.PrintLine(celsius + " degrees Celsius is " + fahrenheit + " degrees Fahrenheit")
                tookAction = True
            End If

            If ConversionKey == "F" Then
                fahrenheit = Console.Input("Enter Fahrenheit: ")
                celsius = Decimal.Format(ConvertFahrenheitToCelsius(String.ToNumeric(fahrenheit)), 1)
                Console.PrintLine(fahrenheit + " degrees Celsius is " + celsius + " degrees Fahrenheit")
                tookAction = True
            End If

            If tookAction == False Then
                Console.PrintLine("I don't know what you want.")
            End If
        End If
    End For

    Console.PrintLine()
    Console.PrintLine("Done.")

	' exit cleanly
	Return ERROR_NO_ERRORS_SUCCESS
End Function

Function MyErrorHandler(errMsg As String)
    Console.Print("Caught runtime error: " + errMsg)
End Function

'----------

Function ConvertCelsiusToFahrenheit(celsius As Numeric) As Numeric
    Return (celsius * 9/5) + 32
End Function

Function ConvertFahrenheitToCelsius(fahrenheit As Numeric) As Numeric
    Return (fahrenheit - 32) * 5/9
End Function

'
' adventure.plain
' 2026-11-14 : Matthew Hickson
'

Const DEFAULT_HEALTH As Numeric = 100

Const Items As List = []

Const Rooms As List = [
	CreateRoom(100, \
		"Cave Entrance", \
		"The dark and foreboding entrance to a large cave.", \
		[
			CreateExit("North", 200),
		]),
	CreateRoom(200, \
		"Cave Room 1", \
		"The room is dark, dank. The floor of the room is relatively flat and level, but dusty and with debris strewn about.", \
		[
			CreateExit("South", 100),
		]),
]

System.SetErrorHandler(MyErrorHandler)
Const Result As Numeric = Main()
System.Exit(Result)

'----------

Function Main() As Numeric
	PrintIntroduction()

	Const PlayerName As String = Console.Input("Enter your name: ")

	Var player As Player = CreatePlayer(PlayerName)
	PrintPlayer(player)

	' exit cleanly
	Return 0
End Function

Function MyErrorHandler(errMsg As String)
    Console.Print("Caught runtime error: " + errMsg)
End Function

'----------

Struct Exit
	Direction As String
	RoomId As Numeric
End Struct

Struct Item
	Id As Numeric
	Name As String
	Description As String
End Struct

Struct Player
	Name As String
	CurrentHealth As Numeric
	Health As Numeric
	Inventory As List 'Of Item
	Score As Numeric
End Struct

Struct Room
	Id As Numeric
	Name As String
	Description As String
	Exits As List 'Of Exit
End Struct

Function CreateExit(direction As String, roomId As Numeric) As Exit
	Var e As Exit
	e.Direction = direction
	e.RoomId = roomId
	Return e
End Function

Function CreatePlayer(name As String) As Player
	Var p As Player
	p.Name = name
	p.CurrentHealth = DEFAULT_HEALTH
	p.Health = DEFAULT_HEALTH
	p.Inventory = []
	p.Score = 0
	Return p
End Function

Function CreateRoom(id As Numeric, name As String, desc As String, exits As List) As Room
	Var r As Room
	r.Id = id
	r.Name = name
	r.Description = desc
	r.Exits = exits
	Return r
End Function

Function PrintIntroduction()
	Console.PrintLine("Welcome to Adventure!")
	Console.PrintLine("---------------------")
	Console.PrintLine()
End Function

Function PrintPlayer(p As Player)
	Console.PrintLine("Player: " + p.Name + " | Health: (" + p.CurrentHealth + "/" + p.Health + ") | Score: " + p.Score)
	Console.PrintLine("Inventory")
	If List.Len(p.Inventory) > 0 Then
		For i As Numeric = 1 To List.Len(p.Inventory) Step 1
			Console.PrintLine("- " + p.Inventory[i].Name + " (" + p.Inventory[i].Description + ")")
		End For
	Else
		Console.PrintLine("<empty>")
	End If
End Function

Function PrintRoom(r As Room)
	Console.PrintLine("[" + r.Name + "]")
	Console.PrintLine(r.Description)

	Console.Print("Exits: ")
	For i As Numeric = 1 To List.Len(r.Exits) Step 1
		Console.Print(r.Exits[i].Direction + " | ")
	End For

	Console.PrintLine()
End Function

System.SetErrorHandler(MyErrorHandler)
Const Result As Numeric = Main()
System.Exit(Result)

'----------

Struct Exit
	Direction As String
	RoomId As Numeric
End Struct

Struct Room
	Id As Numeric
	Name As String
	Description As String
	Exits As List
End Struct

Function CreateExit(direction As String, roomId As Numeric) As Exit
	Var e As Exit
	e.Direction = direction
	e.RoomId = roomId
	Return e
End Function

Function CreateRoom(id As Numeric, name As String, desc As String, exits As List) As Room
	Var r As Room
	r.Id = id
	r.Name = name
	r.Description = desc
	r.Exits = exits
	Return r
End Function

Function Main() As Numeric
	Console.PrintLine("Adventure!")
	PrintRoom(TestRoom)
	Return 0
End Function

Function MyErrorHandler(errMsg As String)
    Console.Print("Caught runtime error: " + errMsg)
End Function

Function PrintRoom(r As Room)
	Console.PrintLine("[" + r.Name + "]")
	Console.PrintLine(r.Description)
	Console.Print("Exits: ")
	'FIX: we need List length calculations to make this dynamic
	'For i As Numeric = 1 To r.Exits[1]
		'Console.Print(r.Exits[1].Direction + " | ") 'FIX: List indexing is also unlikely to work...
	'End For
	Console.PrintLine()
End Function


{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PLAIN",
  "scopeName": "source.plain",
  "fileTypes": [
    "plain"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.plain",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.plain",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.plain",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.plain",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "constant.language.none.plain",
          "match": "\\bNone\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.plain",
          "match": "\\b(If|Then|Else|ElseIf|Select|Case|Else\\s+Case)\\b"
        },
        {
          "name": "keyword.control.loop.plain",
          "match": "\\b(For|To|Step|In)\\b"
        },
        {
          "name": "keyword.control.flow.plain",
          "match": "\\b(Return|End)\\b"
        },
        {
          "name": "keyword.declaration.plain",
          "match": "\\b(Var|Const|Function|Struct|As)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.plain",
          "match": "\\b(Numeric|String|Boolean|List|Struct)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.class.module.plain",
          "match": "\\b(Console|System)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.plain",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.plain",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
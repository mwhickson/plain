{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PLAIN",
  "scopeName": "source.plain",
  "fileTypes": [
    "plain"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#line-continuations"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.plain",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.plain",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.plain",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.plain",
          "match": "\\b(?i:True|False)\\b"
        },
        {
          "name": "constant.language.none.plain",
          "match": "\\b(?i:None)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.plain",
          "match": "\\b(?i:If|Then|Else|ElseIf|Select|Case)\\b"
        },
        {
          "name": "keyword.control.loop.plain",
          "match": "\\b(?i:For|To|Step|While)\\b"
        },
        {
          "name": "keyword.control.flow.plain",
          "match": "\\b(?i:Return|End|Break)\\b"
        },
        {
          "name": "keyword.declaration.plain",
          "match": "\\b(?i:Var|Const|Function|Struct|As)\\b"
        },
        {
          "name": "keyword.operator.logical.plain",
          "match": "\\b(?i:And|Or)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.plain",
          "match": "\\b(?i:Numeric|String|Boolean|List|Struct|Function)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.class.module.plain",
          "match": "\\b(?i:Console|System|List|String|Struct|Math|Random|File|Time|Decimal|Environment)\\b(?=\\s*\\.)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.plain",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.plain",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.plain",
          "match": "==|!=|<=|>=|[=<>+*/-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.plain",
          "match": ",|\\."
        },
        {
          "name": "punctuation.section.group.plain",
          "match": "\\(|\\)|\\[|\\]"
        }
      ]
    },
    "line-continuations": {
      "patterns": [
        {
          "name": "punctuation.separator.continuation.plain",
          "match": "\\\\[ \\t]*\\r?\\n"
        }
      ]
    }
  }
}